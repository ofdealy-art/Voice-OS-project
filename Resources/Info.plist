<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>CFBundleName</key>
    <string>ScreenMate</string>
    <key>CFBundleDisplayName</key>
    <string>ScreenMate</string>
    <key>CFBundleExecutable</key>
    <string>ScreenMate</string>
    <key>CFBundleIdentifier</key>
    <string>com.screenmate.ScreenMate</string>
    <key>CFBundlePackageType</key>
    <string>APPL</string>
    <key>CFBundleShortVersionString</key>
    <string>0.1.0</string>
    <key>CFBundleVersion</key>
    <string>1</string>
    <key>CFBundleInfoDictionaryVersion</key>
    <string>6.0</string>
    <key>LSMinimumSystemVersion</key>
    <string>13.0</string>

    <!-- Accessory app: no Dock icon, no menu bar app menu. The UI is the
         floating panel plus the status item. -->
    <key>LSUIElement</key>
    <true/>

    <key>NSHighResolutionCapable</key>
    <true/>
    <key>NSSupportsAutomaticTermination</key>
    <false/>
    <key>NSSupportsSuddenTermination</key>
    <false/>

    <!-- These strings are what macOS shows in its permission prompts. They say
         what is captured and when, because that prompt is often the only privacy
         notice a user reads. -->
    <key>NSMicrophoneUsageDescription</key>
    <string>ScreenMate opens the microphone only while you hold the voice button or its keyboard shortcut, so you can speak to the assistant instead of typing. It closes as soon as you let go.</string>

    <key>NSSpeechRecognitionUsageDescription</key>
    <string>ScreenMate turns your recording into text so the assistant can answer. Where your Mac supports it, this happens on-device and your voice never leaves the machine.</string>

    <key>NSCameraUsageDescription</key>
    <string>ScreenMate does not use the camera.</string>

    <key>NSAppleEventsUsageDescription</key>
    <string>ScreenMate does not control other apps.</string>
</dict>
</plist>
